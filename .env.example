POST_MODE="intent" # "intent" (default, free): Approve opens X with the tweet prefilled. "api": auto-post via paid X API.
NTFY_CONFIRM_TOPIC="your_unique_ntfy_confirm_topic"
NTFY_SERVER="https://ntfy.sh" # Optional: defaults to public ntfy.sh. Use your own if self-hosting.
HF_TOKEN="your_hugging_face_read_token" # Optional: if not using huggingface-cli login

# Only required when POST_MODE="api"
NTFY_RESPONSE_TOPIC="your_unique_ntfy_response_topic"
X_CONSUMER_KEY="your_x_consumer_key"
X_CONSUMER_SECRET="your_x_consumer_secret"
X_BEARER_TOKEN="your_x_bearer_token"
X_ACCESS_TOKEN="your_x_access_token"
X_ACCESS_TOKEN_SECRET="your_x_access_token_secret"